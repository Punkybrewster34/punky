# HavenOS secrets — copy to .env and fill in. Never commit .env.

# --- Phase 2: Commercial Prospector (Module 4) ---
# Official Google Places API key (Text Search + Place Details).
# Setup guide: docs/places-api-setup.md (written when Phase 2 ships).
GOOGLE_PLACES_API_KEY=

# --- Optional: live Google Sheets reads instead of CSV downloads ---
# CSV-first is the default and needs no credentials. If you later want
# gspread, point this at a Google service-account JSON key file.
GOOGLE_SERVICE_ACCOUNT_JSON=
